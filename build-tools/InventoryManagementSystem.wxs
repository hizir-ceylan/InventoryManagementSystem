<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    WiX Installer for Inventory Management System
    Converts the current Inno Setup installer to MSI format for enterprise deployment
    Excludes web app as specified (since it's in test mode)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" 
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"
     xmlns:fire="http://schemas.microsoft.com/wix/FirewallExtension">

  <!-- Product Information -->
  <Product Id="*" 
           Name="Inventory Management System" 
           Language="1033" 
           Version="1.1.0.0" 
           Manufacturer="Hizir Ceylan" 
           UpgradeCode="{8B9B2A1D-4F5E-4C3B-8A1D-2E3F4A5B6C7D}">

    <!-- Package Information -->
    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine" 
             Platform="x64"
             Description="Enterprise Inventory Management System"
             Comments="Device inventory, tracking and management system for corporate environments" />

    <!-- Media Information -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Installation Properties -->
    <Property Id="ARPHELPLINK" Value="https://github.com/hizir-ceylan/InventoryManagementSystem" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/hizir-ceylan/InventoryManagementSystem" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    
    <!-- System Requirements -->
    <Condition Message="This application requires Windows 10 or Windows Server 2016 or newer.">
      <![CDATA[Installed OR (VersionNT >= 1000)]]>
    </Condition>
    
    <Condition Message="This application requires 64-bit Windows.">
      <![CDATA[Installed OR VersionNT64]]>
    </Condition>

    <!-- .NET 8 Runtime Check -->
    <Property Id="DOTNET8INSTALLED">
      <RegistrySearch Id="DotNet8Search" 
                      Root="HKLM" 
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.NETCore.App" 
                      Name="8.0" 
                      Type="raw" />
    </Property>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="Inventory Management System" Level="1">
      <ComponentGroupRef Id="ApiFilesGroup" />
      <ComponentGroupRef Id="AgentFilesGroup" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="FirewallComponents" />
      <ComponentGroupRef Id="FolderComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

    <!-- Directory Structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Inventory Management System">
          <Directory Id="APIFOLDER" Name="Api" />
          <Directory Id="AGENTFOLDER" Name="Agent" />
          <Directory Id="LOGSFOLDER" Name="Logs" />
          <Directory Id="DATAFOLDER" Name="Data" />
        </Directory>
      </Directory>
      
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Inventory Management System" />
      </Directory>
      
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Create required folders -->
    <DirectoryRef Id="LOGSFOLDER">
      <Component Id="LogsFolder" Guid="{A1234567-B234-C345-D456-E56789ABCDEF}" Win64="yes">
        <CreateFolder />
        <RemoveFolder Id="RemoveLogsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\InventoryManagementSystem\Folders" Name="LogsCreated" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    
    <DirectoryRef Id="DATAFOLDER">
      <Component Id="DataFolder" Guid="{B2345678-C345-D456-E567-F6789ABCDEF0}" Win64="yes">
        <CreateFolder />
        <RemoveFolder Id="RemoveDataFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\InventoryManagementSystem\Folders" Name="DataCreated" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- API and Agent Components will be automatically generated by Heat -->
    <!-- The following component groups are replaced by ApiFilesGroup and AgentFilesGroup -->
    <!--
    <ComponentGroup Id="ApiComponents">
      <Component Id="ApiExecutable" Guid="{A1234567-B234-C345-D456-E56789ABCDEF}" Directory="APIFOLDER">
        <File Id="ApiExe" 
              Source="Published\Api\Inventory.Api.exe" 
              KeyPath="yes" 
              Checksum="yes" />
        <File Id="ApiDll" 
              Source="Published\Api\Inventory.Api.dll" />
        <File Id="ApiConfig" 
              Source="Published\Api\appsettings.json" />
        <File Id="ApiPdb" 
              Source="Published\Api\Inventory.Api.pdb" />
        <File Id="ApiDeps" 
              Source="Published\Api\Inventory.Api.deps.json" />
        <File Id="ApiRuntimeConfig" 
              Source="Published\Api\Inventory.Api.runtimeconfig.json" />
      </Component>
      
      <Component Id="ApiDependencies" Guid="{B2345678-C345-D456-E567-F6789ABCDEF0}" Directory="APIFOLDER">
        <File Id="ApiInventoryData" Source="Published\Api\Inventory.Data.dll" />
        <File Id="ApiInventoryDomain" Source="Published\Api\Inventory.Domain.dll" />
        <File Id="ApiInventoryShared" Source="Published\Api\Inventory.Shared.dll" />
