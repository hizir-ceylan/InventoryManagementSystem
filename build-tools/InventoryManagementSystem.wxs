        <File Id="ApiInventorySharedPdb" Source="Published\Api\Inventory.Shared.pdb" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AgentComponents">
      <Component Id="AgentExecutable" Guid="{C3456789-D456-E567-F678-9ABCDEF01234}" Directory="AGENTFOLDER">
        <File Id="AgentExe" 
              Source="Published\Agent\Inventory.Agent.Windows.exe" 
              KeyPath="yes" 
              Checksum="yes" />
        <File Id="AgentDll" 
              Source="Published\Agent\Inventory.Agent.Windows.dll" />
        <File Id="AgentConfig" 
              Source="Published\Agent\appsettings.json" />
        <File Id="AgentPdb" 
              Source="Published\Agent\Inventory.Agent.Windows.pdb" />
        <File Id="AgentDeps" 
              Source="Published\Agent\Inventory.Agent.Windows.deps.json" />
        <File Id="AgentRuntimeConfig" 
              Source="Published\Agent\Inventory.Agent.Windows.runtimeconfig.json" />
      </Component>
      
      <Component Id="AgentDependencies" Guid="{D4567890-E567-F678-9ABC-DEF012345678}" Directory="AGENTFOLDER">
        <File Id="AgentInventoryShared" Source="Published\Agent\Inventory.Shared.dll" />
        <File Id="AgentInventoryDomain" Source="Published\Agent\Inventory.Domain.dll" />
        <File Id="AgentInventorySharedPdb" Source="Published\Agent\Inventory.Shared.pdb" />
        <File Id="AgentInventoryDomainPdb" Source="Published\Agent\Inventory.Domain.pdb" />
      </Component>
    </ComponentGroup>
    -->

    <!-- Folder Components -->
    <ComponentGroup Id="FolderComponents">
      <ComponentRef Id="LogsFolder" />
      <ComponentRef Id="DataFolder" />
    </ComponentGroup>

    <!-- Windows Services -->
    <ComponentGroup Id="ServiceComponents">
      <!-- API Service -->
      <Component Id="ApiService" Guid="{E5678901-F678-9ABC-DEF0-12345678ABCD}" Directory="APIFOLDER" Win64="yes">
        <CreateFolder />
        <ServiceInstall Id="ApiServiceInstaller"
                        Type="ownProcess"
                        Name="InventoryApiService"
                        DisplayName="Inventory Management API Service"
                        Description="Inventory Management System REST API Service"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Interactive="no">
          <ServiceDependency Id="Tcpip" />
          <ServiceDependency Id="Dnscache" />
        </ServiceInstall>
        
        <ServiceControl Id="ApiServiceControl"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Name="InventoryApiService"
                        Wait="yes" />
        
        <!-- Service arguments for API -->
        <RegistryValue Root="HKLM" 
                       Key="SYSTEM\CurrentControlSet\Services\InventoryApiService" 
                       Name="ImagePath" 
                       Type="string" 
                       Value='"[APIFOLDER]Inventory.Api.exe" --urls "http://localhost:5093"' 
                       KeyPath="yes" />
      </Component>

      <!-- Agent Service -->
      <Component Id="AgentService" Guid="{F6789012-9ABC-DEF0-1234-5678ABCDEF01}" Directory="AGENTFOLDER" Win64="yes">
        <CreateFolder />
        <ServiceInstall Id="AgentServiceInstaller"
                        Type="ownProcess"
                        Name="InventoryAgentService"
                        DisplayName="Inventory Management Agent Service"
                        Description="Inventory Management System Windows Agent Service"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Interactive="no">
          <ServiceDependency Id="InventoryApiService" />
        </ServiceInstall>
        
        <ServiceControl Id="AgentServiceControl"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Name="InventoryAgentService"
                        Wait="yes" />
        
        <RegistryValue Root="HKCU" 
                       Key="Software\InventoryManagementSystem\Services" 
                       Name="AgentInstalled" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Firewall Components -->
    <ComponentGroup Id="FirewallComponents">
      <Component Id="FirewallRule" Guid="{01234567-ABCD-EF01-2345-678ABCDEF012}" Directory="APIFOLDER" Win64="yes">
        <CreateFolder />
        <fire:FirewallException Id="ApiFirewallException"
                                Name="Inventory Management API"
                                Port="5093"
                                Protocol="tcp"
                                Scope="localSubnet"
                                IgnoreFailure="yes"
                                Description="Allow Inventory Management API communication on port 5093" />
        <RegistryValue Root="HKCU" 
                       Key="Software\InventoryManagementSystem\Firewall" 
                       Name="RuleCreated" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Shortcut Components -->
    <ComponentGroup Id="ShortcutComponents">
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </ComponentGroup>

    <!-- Start Menu Shortcuts -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="{12345678-CDEF-0123-4567-8ABCDEF01234}" Win64="yes">
        <Shortcut Id="ApiServiceShortcut"
                  Name="Inventory Management System"
                  Description="Open Inventory Management Web Interface"
                  Target="[SystemFolder]cmd.exe"
                  Arguments="/c start http://localhost:5093/swagger"
                  WorkingDirectory="APIFOLDER" 
                  Icon="BrowserIcon" />
        
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall Inventory Management System"
                  Description="Uninstalls Inventory Management System"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" 
                       Key="Software\Microsoft\InventoryManagementSystem" 
                       Name="installed" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop Shortcut (Optional) -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{23456789-DEF0-1234-5678-ABCDEF012345}" Win64="yes">
        <Condition>DESKTOPSHORTCUT</Condition>
        <Shortcut Id="DesktopApiShortcut"
                  Name="Inventory Management System"
                  Description="Open Inventory Management Web Interface"
                  Target="[SystemFolder]cmd.exe"
                  Arguments="/c start http://localhost:5093/swagger"
                  WorkingDirectory="APIFOLDER" 
                  Icon="BrowserIcon" />
        
        <RegistryValue Root="HKCU" 
                       Key="Software\Microsoft\InventoryManagementSystem" 
                       Name="desktop" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Icon Definition -->
    <Icon Id="BrowserIcon" SourceFile="../Inventory.WebApp/wwwroot/favicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="BrowserIcon" />

    <!-- Custom Actions for .NET 8 Runtime Installation -->
    <CustomAction Id="CheckDotNet8"
                  Property="DOTNET8REQUIRED"
                  Value="1" />

    <CustomAction Id="DownloadDotNet8"
                  Property="DOTNET8URL"
                  Value="https://download.microsoft.com/.../dotnet-runtime-8.0-win-x64.exe" />

    <!-- Installation Sequence -->
    <InstallExecuteSequence>
      <!-- Koşulu burada yaz: .NET 8 yoksa ve ilk kurulumsa -->
      <Custom Action="CheckDotNet8" Before="LaunchConditions">
        NOT DOTNET8INSTALLED AND NOT Installed
      </Custom>
    </InstallExecuteSequence>

    <!-- User Interface -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="DESKTOPSHORTCUT" Value="0" />
    
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      
      <!-- Custom dialog for desktop shortcut -->
      <DialogRef Id="DesktopShortcutDlg" />
    </UI>
  </Product>
    <!-- Custom Dialog for Desktop Shortcut -->
  <Fragment>
    <UI>
      <Dialog Id="DesktopShortcutDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="DesktopShortcutText"
                Type="Text"
                X="20" Y="60" Width="330" Height="30"
                TabSkip="yes"
                Text="Create a desktop shortcut for quick access." />
        
        <!-- EKSİK OLAN ÖZNİTELİKLER EKLENDİ -->
        <Control Id="DesktopShortcutCheckBox"
                Type="CheckBox"
                X="20" Y="100" Width="330" Height="17"
                Property="DESKTOPSHORTCUT"
                CheckBoxValue="1"
                Text="Create a desktop shortcut" />

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>