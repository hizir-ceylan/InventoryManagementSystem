@page
@model NetworkScanModel
@{
    ViewData["Title"] = "Ağ Taraması";
}

<div class="main-content">
    <!-- Loading Indicator -->
    <div id="loading" class="loading-container d-none">
        <div class="tea-loader">
            <div class="tea-cup">
                <div class="tea-steam"></div>
                <div class="tea-steam"></div>
                <div class="tea-steam"></div>
            </div>
        </div>
        <p class="loading-text">Veriler yükleniyor...</p>
    </div>

    <!-- Error Alert -->
    <div id="error-alert" class="error-alert d-none">
        <div class="error-content">
            <i class="bi bi-exclamation-triangle"></i>
            <span id="error-message">Bir hata oluştu.</span>
            <button type="button" class="error-close" onclick="hideError()">
                <i class="bi bi-x"></i>
            </button>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div id="stats-cards" class="stats-section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-card primary-card" onclick="app.handleStatCardClick('total')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Toplam Cihaz</h3>
                            <h2 class="stat-number" id="total-devices">-</h2>
                            <p class="stat-description">Kayıtlı cihazlar</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-laptop"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>

                <div class="stat-card success-card" onclick="app.handleStatCardClick('active')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Aktif Cihazlar</h3>
                            <h2 class="stat-number" id="active-devices">-</h2>
                            <p class="stat-description">Çalışır durumda</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-check-circle"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>

                <div class="stat-card update-card" onclick="app.handleStatCardClick('updates')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Güncelleme Mevcut</h3>
                            <h2 class="stat-number" id="update-devices">-</h2>
                            <p class="stat-description">Güncellenmesi gereken</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-arrow-up-circle"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Network Scan Page -->
    <div class="pages-container">
        <div class="container">
            <div class="page active">
                <!-- Network Scan Page Content -->
                <div class="page-card">
                    <div class="page-header">
                        <div class="page-title">
                            <h2>
                                <i class="bi bi-wifi"></i>
                                Ağ Taraması
                            </h2>
                            <p>Ağınızdaki cihazları keşfedin ve envantere ekleyin</p>
                        </div>
                    </div>
                    
                    <div class="network-scan-content">
                        <div class="scan-config">
                            <h5><i class="bi bi-gear"></i> Tarama Ayarları</h5>
                            <div class="config-form">
                                <div class="form-group">
                                    <label for="network-range">Ağ Aralığı:</label>
                                    <div class="input-group">
                                        <select id="network-range-preset" class="form-control" onchange="app.updateNetworkRange()">
                                            <option value="">-- Özel Aralık --</option>
                                            <option value="auto">Otomatik Algıla</option>
                                            <option value="192.168.1.0/24">192.168.1.0/24 (Yaygın Ev Ağı)</option>
                                            <option value="192.168.0.0/24">192.168.0.0/24 (Yaygın Ev Ağı)</option>
                                            <option value="10.0.0.0/24">10.0.0.0/24 (Kurumsal Ağ)</option>
                                            <option value="172.16.0.0/24">172.16.0.0/24 (Özel Ağ)</option>
                                            <option value="100.64.0.0/24">100.64.0.0/24 (Carrier NAT)</option>
                                            <option value="105.0.0.0/24">105.0.0.0/24 (Özel Aralık)</option>
                                            <option value="112.0.0.0/24">112.0.0.0/24 (Özel Aralık)</option>
                                        </select>
                                        <input type="text" id="network-range" class="form-control" value="auto" placeholder="Örn: 192.168.1.0/24 veya 105.10.5.0/24">
                                    </div>
                                    <small class="form-text text-muted">
                                        Taranacak ağ aralığını seçin veya özel aralık girin. "Otomatik Algıla" seçeneği yerel ağ arayüzlerinizi kullanır.
                                    </small>
                                </div>
                                <div class="form-group">
                                    <label for="scan-timeout">Zaman Aşımı (saniye):</label>
                                    <input type="number" id="scan-timeout" class="form-control" value="5" min="1" max="30">
                                </div>
                                <div class="form-group">
                                    <label for="port-scan">Port Taraması:</label>
                                    <select id="port-scan" class="form-control">
                                        <option value="common">Yaygın Portlar</option>
                                        <option value="all">Tüm Portlar</option>
                                        <option value="none">Port Taraması Yok</option>
                                    </select>
                                </div>
                                <button class="btn-primary" onclick="app.startNetworkScan()" id="start-scan-btn">
                                    <i class="bi bi-play-fill"></i>
                                    Taramayı Başlat
                                </button>
                            </div>
                        </div>

                        <div class="scan-results" id="scan-results" style="display: none;">
                            <h5><i class="bi bi-search"></i> Tarama Sonuçları</h5>
                            <div class="scan-progress" id="scan-progress">
                                <div class="progress-bar">
                                    <div class="progress-fill" id="progress-fill"></div>
                                </div>
                                <p id="scan-status">Tarama başlatılıyor...</p>
                            </div>
                            <div class="results-table" id="results-table" style="display: none;">
                                <table class="scan-results-table">
                                    <thead>
                                        <tr>
                                            <th>IP Adresi</th>
                                            <th>MAC Adresi</th>
                                            <th>Cihaz Adı</th>
                                            <th>Durum</th>
                                            <th>Açık Portlar</th>
                                            <th>İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody id="scan-results-body">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/config.js"></script>
    <script src="~/js/modules/navigation.js"></script>
    <script src="~/js/modules/api.js"></script>
    <script src="~/js/modules/ui.js"></script>
    <script src="~/js/modules/network-scan.js"></script>
    <script src="~/js/app-modular.js"></script>
}