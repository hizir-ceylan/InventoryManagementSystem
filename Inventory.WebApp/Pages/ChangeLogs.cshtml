@page
@model ChangeLogsModel
@{
    ViewData["Title"] = "Değişiklik Logları";
}

<div class="main-content">
    <!-- Loading Indicator -->
    <div id="loading" class="loading-container d-none">
        <div class="tea-loader">
            <div class="tea-cup">
                <div class="tea-steam"></div>
                <div class="tea-steam"></div>
                <div class="tea-steam"></div>
            </div>
        </div>
        <p class="loading-text">Veriler yükleniyor...</p>
    </div>

    <!-- Error Alert -->
    <div id="error-alert" class="error-alert d-none">
        <div class="error-content">
            <i class="bi bi-exclamation-triangle"></i>
            <span id="error-message">Bir hata oluştu.</span>
            <button type="button" class="error-close" onclick="hideError()">
                <i class="bi bi-x"></i>
            </button>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div id="stats-cards" class="stats-section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-card primary-card" onclick="app.handleStatCardClick('total')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Toplam Cihaz</h3>
                            <h2 class="stat-number" id="total-devices">-</h2>
                            <p class="stat-description">Kayıtlı cihazlar</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-laptop"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>

                <div class="stat-card success-card" onclick="app.handleStatCardClick('active')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Aktif Cihazlar</h3>
                            <h2 class="stat-number" id="active-devices">-</h2>
                            <p class="stat-description">Çalışır durumda</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-check-circle"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>

                <div class="stat-card update-card" onclick="app.handleStatCardClick('updates')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Güncelleme Mevcut</h3>
                            <h2 class="stat-number" id="update-devices">-</h2>
                            <p class="stat-description">Güncellenmesi gereken</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-arrow-up-circle"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Change Logs Page -->
    <div class="pages-container">
        <div class="container">
            <div class="page active">
                <!-- Change Logs Page Content -->
                <div class="page-card">
                    <div class="page-header">
                        <div class="page-title">
                            <h2>
                                <i class="bi bi-clock-history"></i>
                                Değişiklik Logları
                            </h2>
                            <p>Sistemdeki değişiklikleri takip edin</p>
                        </div>
                        <button class="btn-refresh" onclick="app.refreshChangeLogs()">
                            <i class="bi bi-arrow-clockwise"></i>
                            <span>Yenile</span>
                        </button>
                    </div>
                    
                    <div class="change-logs-content">
                        <div class="filters-section">
                            <div class="filter-row">
                                <div class="filter-group">
                                    <select id="filter-change-type" class="filter-select">
                                        <option value="">Tüm Değişiklik Türleri</option>
                                        <option value="Name">Cihaz Adı</option>
                                        <option value="IpAddress">IP Adresi</option>
                                        <option value="Status">Durum</option>
                                        <option value="Location">Konum</option>
                                        <option value="HardwareInfo">Donanım</option>
                                        <option value="SoftwareInfo">Yazılım</option>
                                    </select>
                                    <select id="filter-device" class="filter-select">
                                        <option value="">Tüm Cihazlar</option>
                                    </select>
                                    <input type="date" id="filter-date-from" class="filter-select" title="Başlangıç Tarihi">
                                    <input type="date" id="filter-date-to" class="filter-select" title="Bitiş Tarihi">
                                    <button class="btn-clear" onclick="app.clearChangeLogFilters()">
                                        <i class="bi bi-x-circle"></i>
                                        <span>Temizle</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="change-logs-table-container">
                            <table class="change-logs-table">
                                <thead>
                                    <tr>
                                        <th>Tarih/Saat</th>
                                        <th>Cihaz</th>
                                        <th>Değişiklik Türü</th>
                                        <th class="hide-mobile">Eski Değer</th>
                                        <th class="hide-mobile">Yeni Değer</th>
                                        <th class="hide-mobile">Değiştiren</th>
                                    </tr>
                                </thead>
                                <tbody id="change-logs-body">
                                </tbody>
                            </table>
                        </div>

                        <div id="no-change-logs" class="no-data d-none">
                            <div class="no-data-content">
                                <i class="bi bi-journal-text"></i>
                                <h3>Henüz değişiklik logu bulunmuyor</h3>
                                <p>Cihaz değişiklikleri burada görüntülenecek.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/config.js"></script>
    <script src="~/js/modules/navigation.js"></script>
    <script src="~/js/modules/api.js"></script>
    <script src="~/js/modules/ui.js"></script>
    <script src="~/js/modules/statistics.js"></script>
    <script src="~/js/modules/change-logs.js"></script>
    <script src="~/js/app-modular.js"></script>
}