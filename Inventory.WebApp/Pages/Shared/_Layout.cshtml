<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Çaykur Envanter Yönetim Sistemi</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/components/vmware.css" rel="stylesheet">
    <link href="~/css/components/dashboard.css" rel="stylesheet">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <!-- Left side: Brand -->
            <div class="navbar-left">
                <div class="navbar-brand">
                    <div class="logo">
                        <span>Çaykur</span>
                    </div>
                    <span class="subtitle">Envanter Yönetim Sistemi</span>
                </div>
            </div>
            
            <!-- Center: Navigation Menu -->
            <div class="navbar-center">
                <div class="navbar-toggle" id="navbar-toggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                
                <div class="navbar-menu" id="navbar-menu">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" href="/">
                                <i class="bi bi-house"></i>
                                <span>Ana Sayfa</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Devices" ? "active" : "")" href="/Devices">
                                <i class="bi bi-laptop"></i>
                                <span>Cihazlar</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/DeviceDetails" ? "active" : "")" href="/DeviceDetails">
                                <i class="bi bi-info-circle"></i>
                                <span>Cihaz Detayları</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/NetworkScan" ? "active" : "")" href="/NetworkScan">
                                <i class="bi bi-wifi"></i>
                                <span>Ağ Taraması</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/ChangeLogs" ? "active" : "")" href="/ChangeLogs">
                                <i class="bi bi-clock-history"></i>
                                <span>Değişiklik Logları</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/VMwareStatus" ? "active" : "")" href="/VMwareStatus">
                                <i class="bi bi-cloud"></i>
                                <span>VMware Durumu</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link external" href="#" onclick="openApiDocumentation()" target="_blank">
                                <i class="bi bi-code-square"></i>
                                <span>API Dökümanları</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            
            <!-- Right side: No status indicator anymore -->
            <div class="navbar-right">
                <!-- Status indicator removed as requested -->
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>