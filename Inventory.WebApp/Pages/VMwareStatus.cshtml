@page
@model VMwareStatusModel
@{
    ViewData["Title"] = "VMware Durumu";
}

<div class="main-content">
    <!-- Loading Indicator -->
    <div id="loading" class="loading-container d-none">
        <div class="tea-loader">
            <div class="tea-cup">
                <div class="tea-steam"></div>
                <div class="tea-steam"></div>
                <div class="tea-steam"></div>
            </div>
        </div>
        <p class="loading-text">Veriler yükleniyor...</p>
    </div>

    <!-- Error Alert -->
    <div id="error-alert" class="error-alert d-none">
        <div class="error-content">
            <i class="bi bi-exclamation-triangle"></i>
            <span id="error-message">Bir hata oluştu.</span>
            <button type="button" class="error-close" onclick="hideError()">
                <i class="bi bi-x"></i>
            </button>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div id="stats-cards" class="stats-section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-card primary-card" onclick="app.handleStatCardClick('total')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Toplam Cihaz</h3>
                            <h2 class="stat-number" id="total-devices">-</h2>
                            <p class="stat-description">Kayıtlı cihazlar</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-laptop"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>

                <div class="stat-card success-card" onclick="app.handleStatCardClick('active')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Aktif Cihazlar</h3>
                            <h2 class="stat-number" id="active-devices">-</h2>
                            <p class="stat-description">Çalışır durumda</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-check-circle"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>

                <div class="stat-card update-card" onclick="app.handleStatCardClick('updates')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Güncelleme Mevcut</h3>
                            <h2 class="stat-number" id="update-devices">-</h2>
                            <p class="stat-description">Güncellenmesi gereken</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-arrow-up-circle"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>

                <div class="stat-card virtual-card" onclick="app.handleStatCardClick('virtual')">
                    <div class="stat-content">
                        <div class="stat-info">
                            <h3 class="stat-title">Sanal Cihazlar</h3>
                            <h2 class="stat-number" id="virtual-devices">-</h2>
                            <p class="stat-description">VMware ortamında</p>
                        </div>
                        <div class="stat-icon">
                            <i class="bi bi-cloud"></i>
                            <div class="icon-bg"></div>
                        </div>
                    </div>
                    <div class="stat-waves">
                        <div class="wave wave1"></div>
                        <div class="wave wave2"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- VMware Status Page -->
    <div class="pages-container">
        <div class="container">
            <div class="page active">
                <!-- VMware Status Page Content -->
                <div class="page-card">
                    <div class="page-header">
                        <div class="page-title">
                            <h2>
                                <i class="bi bi-cloud"></i>
                                VMware Durumu
                            </h2>
                            <p>VMware vSphere sunucu durumu ve sanal makine bilgileri</p>
                        </div>
                        <button class="btn-refresh" onclick="vmware.refreshData()">
                            <i class="bi bi-arrow-clockwise"></i>
                            <span>Yenile</span>
                        </button>
                    </div>
                    
                    <div class="vmware-content">
                        <!-- Server Connection Status -->
                        <div class="vmware-section">
                            <h5><i class="bi bi-server"></i> Sunucu Bağlantısı</h5>
                            <div class="server-status" id="server-status">
                                <div class="status-item">
                                    <span class="status-label">Sunucu Adresi:</span>
                                    <span class="status-value" id="server-address">10.0.0.10</span>
                                </div>
                                <div class="status-item">
                                    <span class="status-label">Bağlantı Durumu:</span>
                                    <span class="status-value" id="connection-status">
                                        <span class="status-indicator offline"></span>
                                        Bağlantı kontrol ediliyor...
                                    </span>
                                </div>
                                <div class="status-item">
                                    <span class="status-label">Son Güncelleme:</span>
                                    <span class="status-value" id="last-sync">--</span>
                                </div>
                            </div>
                        </div>

                        <!-- Server Metrics -->
                        <div class="vmware-section">
                            <h5><i class="bi bi-speedometer2"></i> Sunucu Metrikleri</h5>
                            <div class="metrics-grid">
                                <div class="metric-card">
                                    <div class="metric-icon">
                                        <i class="bi bi-hdd"></i>
                                    </div>
                                    <div class="metric-content">
                                        <h6>Toplam Depolama</h6>
                                        <span class="metric-value" id="total-storage">-- GB</span>
                                    </div>
                                </div>
                                <div class="metric-card">
                                    <div class="metric-icon">
                                        <i class="bi bi-hdd-fill"></i>
                                    </div>
                                    <div class="metric-content">
                                        <h6>Kullanılan Depolama</h6>
                                        <span class="metric-value" id="used-storage">-- GB</span>
                                    </div>
                                </div>
                                <div class="metric-card">
                                    <div class="metric-icon">
                                        <i class="bi bi-hdd-stack"></i>
                                    </div>
                                    <div class="metric-content">
                                        <h6>Boş Depolama</h6>
                                        <span class="metric-value" id="free-storage">-- GB</span>
                                    </div>
                                </div>
                                <div class="metric-card">
                                    <div class="metric-icon">
                                        <i class="bi bi-cpu"></i>
                                    </div>
                                    <div class="metric-content">
                                        <h6>CPU Kullanımı</h6>
                                        <span class="metric-value" id="cpu-usage">--%</span>
                                    </div>
                                </div>
                                <div class="metric-card">
                                    <div class="metric-icon">
                                        <i class="bi bi-memory"></i>
                                    </div>
                                    <div class="metric-content">
                                        <h6>RAM Kullanımı</h6>
                                        <span class="metric-value" id="memory-usage">--%</span>
                                    </div>
                                </div>
                                <div class="metric-card">
                                    <div class="metric-icon">
                                        <i class="bi bi-laptop"></i>
                                    </div>
                                    <div class="metric-content">
                                        <h6>Aktif VM'ler</h6>
                                        <span class="metric-value" id="active-vms">--</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Virtual Machines List -->
                        <div class="vmware-section">
                            <h5><i class="bi bi-cloud-arrow-down"></i> Sanal Makineler</h5>
                            <div class="vm-controls">
                                <button class="btn-primary" onclick="vmware.syncVirtualMachines()">
                                    <i class="bi bi-arrow-down-circle"></i>
                                    <span>VM'leri Senkronize Et</span>
                                </button>
                            </div>
                            
                            <div class="table-container">
                                <table class="vmware-table">
                                    <thead>
                                        <tr>
                                            <th>VM Adı</th>
                                            <th>IP Adresi</th>
                                            <th>Durum</th>
                                            <th class="hide-mobile">İşletim Sistemi</th>
                                            <th class="hide-mobile">CPU</th>
                                            <th class="hide-mobile">RAM (GB)</th>
                                            <th class="hide-mobile">Disk (GB)</th>
                                            <th>İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody id="vm-table-body">
                                    </tbody>
                                </table>
                            </div>

                            <div id="no-vms" class="no-data d-none">
                                <div class="no-data-content">
                                    <i class="bi bi-cloud-slash"></i>
                                    <h3>Hiç sanal makine bulunamadı</h3>
                                    <p>VMware sunucusuna bağlanın ve sanal makineleri senkronize edin.</p>
                                    <button class="btn-primary" onclick="vmware.testConnection()">
                                        <i class="bi bi-cloud-check"></i>
                                        Bağlantıyı Test Et
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Configuration -->
                        <div class="vmware-section">
                            <h5><i class="bi bi-gear"></i> VMware Ayarları</h5>
                            <div class="config-form">
                                <div class="form-group">
                                    <label for="vmware-server">vSphere Sunucu Adresi:</label>
                                    <input type="text" id="vmware-server" class="form-control" value="10.0.0.10" placeholder="10.0.0.10">
                                </div>
                                <div class="form-group">
                                    <label for="vmware-username">Kullanıcı Adı:</label>
                                    <input type="text" id="vmware-username" class="form-control" placeholder="administrator@vsphere.local">
                                </div>
                                <div class="form-group">
                                    <label for="vmware-password">Şifre:</label>
                                    <input type="password" id="vmware-password" class="form-control" placeholder="••••••••">
                                </div>
                                <div class="form-group">
                                    <label for="vmware-sync-interval">Senkronizasyon Aralığı (dakika):</label>
                                    <input type="number" id="vmware-sync-interval" class="form-control" value="30" min="5" max="1440">
                                </div>
                                <button class="btn-primary" onclick="vmware.saveConfiguration()">
                                    <i class="bi bi-check"></i>
                                    Ayarları Kaydet
                                </button>
                                <button class="btn-secondary" onclick="vmware.testConnection()">
                                    <i class="bi bi-cloud-check"></i>
                                    Bağlantıyı Test Et
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/config.js"></script>
    <script src="~/js/modules/navigation.js"></script>
    <script src="~/js/modules/api.js"></script>
    <script src="~/js/modules/ui.js"></script>
    <script src="~/js/modules/vmware.js"></script>
    <script src="~/js/app-modular.js"></script>
}